@inject IStringLocalizer<SharedResource> Localizer

<StatusMessage Message="@StatusMessage" />
<h3>@Localizer["ShowRecoveryCodes.Title"]</h3>

<FluentGrid>
    <FluentGridItem sm="12">
        <FluentMessageBar Margin="@Margin.Bottom2" Intent="MessageBarIntent.Warning" AllowDismiss="false">@Localizer["ShowRecoveryCodes.Warning.SafePlace"]</FluentMessageBar>
        <p>
            @Localizer["ShowRecoveryCodes.Info.LoseAccess"]
        </p>
    </FluentGridItem>
    <FluentGridItem sm="12">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <div>
                <code class="recovery-code">@recoveryCode</code>
            </div>
        }

    </FluentGridItem>

</FluentGrid>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
