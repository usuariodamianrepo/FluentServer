@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using Clone.Models

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject IStringLocalizer<PersonalData> Localizer

<PageTitle>@Localizer["Title"]</PageTitle>

<StatusMessage />
<h3>@Localizer["Title"]</h3>

<FluentGrid>
    <FluentGridItem xs="12" sm="6">
        <p>@Localizer["Info"]</p>
        <p>
            <strong>@Localizer["Warning.Delete"]</strong>
        </p>
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary" Style="width:20%;">@Localizer["Button.Download"]</FluentButton>
        </form>

        <p style="margin-top: 10px; text-align: end;">
            <FluentLink Href="Account/Manage/DeletePersonalData">@Localizer["Link.DeletePersonalData"]</FluentLink>
        </p>
    </FluentGridItem>
</FluentGrid>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
