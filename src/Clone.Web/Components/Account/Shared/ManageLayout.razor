@inherits LayoutComponentBase
@layout Clone.Web.Components.Layout.MainLayout

@inject IStringLocalizer<SharedResource> Localizer

<h1>@Localizer["ManageLayout.Title"]</h1>

<div>
    <h2>@Localizer["ManageLayout.Subtitle"]</h2>
    <FluentGrid Spacing="2">
        <FluentGridItem sm="3">
            <ManageNavMenu />
        </FluentGridItem>

        <FluentGridItem sm="9">
            @Body
        </FluentGridItem>
    </FluentGrid>
</div>
