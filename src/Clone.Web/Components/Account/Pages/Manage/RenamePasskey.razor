@page "/Account/Manage/RenamePasskey/{Id}"

@using Clone.Models
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using System.Buffers.Text

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject IStringLocalizer<RenamePasskey> Localizer

<FluentGrid>
    <FluentGridItem xs="12" sm="6">
        <EditForm Model="Input" OnValidSubmit="Rename" FormName="rename-passkey" method="post" style="padding: 10px 0; width: 100%;">
            <DataAnnotationsValidator />
            @if (passkey?.Name is { } name)
            {
                <h4>@Localizer["Title.NewName", name]</h4>
            }
            else
            {
                <h4>@Localizer["Title.Name"]</h4>
            }
            <hr />
            <FluentValidationSummary class="text-danger" role="alert" />
            <FluentTextInput Style="width: 100%;" Label="@Localizer["Label.PasskeyName"]" @bind-Value="Input.Name" Id="Input.Name" Name="Input.Name" Required="true" Placeholder="@Localizer["Placeholder.PasskeyName"]" />
            <p style="margin-top: 10px; text-align: end;">
                <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary">@Localizer["Button.Continue"]</FluentButton>
            </p>
        </EditForm>
    </FluentGridItem>
</FluentGrid>

@code {
    private ApplicationUser? user;
    private UserPasskeyInfo? passkey;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [Parameter]
    public string? Id { get; set; }

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = (await UserManager.GetUserAsync(HttpContext.User))!;
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        byte[] credentialId;
        try
        {
            credentialId = Base64Url.DecodeFromChars(Id);
        }
        catch (FormatException)
        {
            RedirectManager.RedirectToWithStatus("Account/Manage/Passkeys", Localizer["Error.InvalidPasskeyIdFormat"], HttpContext);
            return;
        }

        passkey = await UserManager.GetPasskeyAsync(user, credentialId);
        if (passkey is null)
        {
            RedirectManager.RedirectToWithStatus("Account/Manage/Passkeys", Localizer["Error.PasskeyNotFound"], HttpContext);
            return;
        }
    }

    private async Task Rename()
    {
        passkey!.Name = Input.Name;
        var result = await UserManager.AddOrUpdatePasskeyAsync(user!, passkey);
        if (!result.Succeeded)
        {
            RedirectManager.RedirectToWithStatus("Account/Manage/Passkeys", Localizer["Error.PasskeyCouldNotBeUpdated"], HttpContext);
            return;
        }

        RedirectManager.RedirectToWithStatus("Account/Manage/Passkeys", Localizer["Message.PasskeyUpdated"], HttpContext);
    }

    private sealed class InputModel
    {
        [Required]
        [StringLength(200, ErrorMessageResourceType = typeof(RenamePasskeyResources), ErrorMessageResourceName = nameof(RenamePasskeyResources.PasskeyNameLength))]
        public string Name { get; set; } = "";
    }
}
