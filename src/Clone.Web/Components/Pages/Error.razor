@page "/Error"
@using System.Diagnostics

@inject IStringLocalizer<Error> Localizer

<PageTitle>@Localizer["Title"]</PageTitle>

<h1 class="text-danger">@Localizer["Heading"]</h1>
<h2 class="text-danger">@Localizer["Subtitle"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@Localizer["RequestId"]</strong> <code>@RequestId</code>
    </p>
}

<h3>@Localizer["DevelopmentMode"]</h3>
<p>
    @Localizer["SwappingTo"] <strong>Development</strong> @Localizer["MoreDetails"]
</p>
<p>
    <strong>@Localizer["Warning.NotForProductionPrefix"] Development @Localizer["Warning.NotForProductionSuffix"]</strong>
    @Localizer["Warning.SensitiveInfo"]
    @Localizer["Debug.Prefix"] <strong>Development</strong> @Localizer["Debug.Middle"] <strong>ASPNETCORE_ENVIRONMENT</strong> @Localizer["Debug.Variable"] <strong>Development</strong> @Localizer["Debug.Suffix"]
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
