@using Microsoft.AspNetCore.Identity
@using Clone.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject IStringLocalizer<SharedResource> Localizer

<FluentNav>
    <FluentNavItem Href="Account/Manage" Match="NavLinkMatch.All">@Localizer["ManageNav.Profile"]</FluentNavItem>
    <FluentNavItem Href="Account/Manage/Email">@Localizer["ManageNav.Email"]</FluentNavItem>
    <FluentNavItem Href="Account/Manage/ChangePassword">@Localizer["ManageNav.Password"]</FluentNavItem>
    @if (hasExternalLogins)
    {
        <FluentNavItem Href="Account/Manage/ExternalLogins">@Localizer["ManageNav.ExternalLogins"]</FluentNavItem>
    }
    <FluentNavItem Href="Account/Manage/TwoFactorAuthentication">@Localizer["ManageNav.TwoFactorAuthentication"]</FluentNavItem>
    <FluentNavItem Href="Account/Manage/Passkeys">@Localizer["ManageNav.Passkeys"]</FluentNavItem>
    <FluentNavItem Href="Account/Manage/PersonalData">@Localizer["ManageNav.PersonalData"]</FluentNavItem>
</FluentNav>


@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
