@rendermode InteractiveServer

@implements IDisposable

@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> Localizer

<FluentNav Id="main-menu" Width="260px">
    <FluentNavItem Href="/" Match="NavLinkMatch.All" IconRest="@(new Icons.Regular.Size20.Home())" IconActive="@(new Icons.Filled.Size20.Home())">@Localizer["Nav.Home"]</FluentNavItem>
    <AuthorizeView>
        <Authorized>
            <FluentNavItem Href="adminusers" IconRest="@(new Icons.Regular.Size20.Person())" IconActive="@(new Icons.Filled.Size20.Person())">@Localizer["Nav.AdminUsers"]</FluentNavItem>
            <FluentNavItem Href="companies" IconRest="@(new Icons.Regular.Size20.Building())" IconActive="@(new Icons.Filled.Size20.Building())">@Localizer["Nav.Companies"]</FluentNavItem>
            <FluentNavItem Href="costcenters" IconRest="@(new Icons.Regular.Size20.Tag())" IconActive="@(new Icons.Filled.Size20.Tag())">@Localizer["Nav.CostCenters"]</FluentNavItem>
            <FluentNavItem Href="receipts" IconRest="@(new Icons.Regular.Size20.ReceiptMoney())" IconActive="@(new Icons.Filled.Size20.ReceiptMoney())">@Localizer["Nav.Receipts"]</FluentNavItem>
            <FluentNavCategory Title="@Localizer["Nav.Misc"]" IconRest="@(new Icons.Regular.Size20.NotePin())" IconActive="@(new Icons.Filled.Size20.NotePin())">
                <FluentNavItem Href="misc/documents" IconRest="@(new Icons.Regular.Size20.Document())" IconActive="@(new Icons.Filled.Size20.Document())">@Localizer["Nav.Documents"]</FluentNavItem>
                <FluentNavItem Href="misc/documenttypes" IconRest="@(new Icons.Regular.Size20.Document())" IconActive="@(new Icons.Filled.Size20.Document())">@Localizer["Nav.DocumentTypes"]</FluentNavItem>
            </FluentNavCategory>
            <FluentNavItem Href="Account/Manage">@context.User.Identity?.Name</FluentNavItem>
            <form action="Account/Logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                <FluentButton Type="ButtonType.Submit" Style="width: 100%;">@Localizer["Nav.Logout"]</FluentButton>
            </form>
        </Authorized>
        <NotAuthorized>
            <FluentNavItem Href="Account/Register" IconRest="@(new Icons.Regular.Size20.Person())" IconActive="@(new Icons.Filled.Size20.Person())">@Localizer["Nav.Register"]</FluentNavItem>
            <FluentNavItem Href="Account/Login" IconRest="@(new Icons.Regular.Size20.LockClosedKey())" IconActive="@(new Icons.Filled.Size20.LockClosedKey())">@Localizer["Nav.Login"]</FluentNavItem>
        </NotAuthorized>
    </AuthorizeView>
</FluentNav>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
